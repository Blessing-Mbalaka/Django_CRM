# Generate a unique production value, for example:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-a-long-random-production-secret
DEBUG=False
ALLOWED_HOSTS=app.example.co.za
CORS_ALLOW_ALL_ORIGINS=False

# Development only (same-origin browser requests do not require CORS):
# DEBUG=True
# ALLOWED_HOSTS=localhost,127.0.0.1

# --- Twilio Email API ---------------------------------------------------------
# Create an Email API Key SID/Secret in Twilio Console and verify the sender.
# Use these dedicated keys for Email API Basic Auth, not the main Auth Token.
# https://www.twilio.com/docs/email/api/getting-started
# https://www.twilio.com/docs/email/api/mail-send
TWILIO_EMAIL_API_KEY=
TWILIO_EMAIL_API_SECRET=
TWILIO_EMAIL_FROM_ADDRESS=
TWILIO_EMAIL_FROM_NAME=

# --- Twilio SMS ---------------------------------------------------------------
# Copy the Account SID, create an API Key SID/Secret, and retain the Auth Token
# for signed webhook validation. Configure either a sender number or Messaging
# Service SID. Twilio trial destination restrictions still apply.
# https://console.twilio.com/
# https://www.twilio.com/docs/iam/api-keys
# https://www.twilio.com/docs/messaging/api/message-resource
# https://www.twilio.com/docs/messaging/guides/track-outbound-message-status
# https://www.twilio.com/docs/usage/webhooks/webhooks-security
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
# Public HTTPS URL for the Marketing Twilio status webhook.
TWILIO_STATUS_CALLBACK_URL=

# --- Meta Graph API -----------------------------------------------------------
# Create a Meta app, copy its App Secret, and choose a private random webhook
# verify token. Pin a supported Graph API version and test before upgrading.
# https://developers.facebook.com/apps/
# https://developers.facebook.com/docs/graph-api/changelog/
META_GRAPH_API_VERSION=v24.0
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# WhatsApp Cloud API: copy the token, Phone Number ID, and WhatsApp Business
# Account ID from the app's WhatsApp setup. Development tokens are short-lived;
# production should use an appropriately scoped long-lived/system-user token.
# https://www.postman.com/meta/whatsapp-business-platform/
META_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=

# Facebook Page publishing requires a Page ID and Page access token with the
# approved Page permissions. It does not publish to personal profiles.
# https://developers.facebook.com/docs/pages-api/posts/
META_FACEBOOK_PAGE_ID=
META_FACEBOOK_PAGE_ACCESS_TOKEN=

# Instagram publishing requires a connected Professional account, approved
# publishing permissions, and images reachable by Meta over public HTTPS.
# https://developers.facebook.com/docs/instagram-platform/content-publishing/
# https://www.postman.com/meta/instagram/
META_INSTAGRAM_USER_ID=
META_INSTAGRAM_ACCESS_TOKEN=

# Public HTTPS origin for provider callbacks and provider-accessible media.
# Example format only: https://crm.example.co.za (no trailing slash)
MARKETING_PUBLIC_BASE_URL=
